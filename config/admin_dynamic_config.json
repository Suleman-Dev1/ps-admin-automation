  "compliance": {
    "strict_mode": true,
    "mandatory_disclaimer": "NOTICE: Information only \u2014 not professional tax, accounting, or legal advice. This administrative summary extracts factual data for review by licensed professionals.",
    "confidence_review_threshold": 0.85,
    "block_prescriptive_tax_advice": true,
    "block_prescriptive_legal_advice": true
