# =================================================================
# Professional Services Admin Automation - Environment Variables
# =================================================================
# NOTE: The application is designed to run 100% out of the box with
# zero initial configuration. If Supabase or OpenAI keys are omitted,
# the app seamlessly activates its built-in local JSON data engine
# and intelligent mock extraction fallback.
# =================================================================

# 1. OpenAI Integration (Multimodal GPT-4o document extraction & summaries)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# 2. Supabase Integration (Optional: activates remote PostgreSQL + Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 3. Resend Integration (Email notification & reminder delivery)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@yourfirm.com

# 4. CRM Integration (Multi-CRM sync)
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=appYourBaseIdHere
HUBSPOT_ACCESS_TOKEN=pat-na1-your-hubspot-token-here

# 5. Cal.com Gated Meeting Scheduling
NEXT_PUBLIC_CAL_USERNAME=apex-advisory
NEXT_PUBLIC_CAL_EVENT_SLUG=30min-onboarding

# 6. Application Host
NEXT_PUBLIC_APP_URL=http://localhost:3000
